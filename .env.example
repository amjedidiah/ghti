# Copy to .env.local and fill in. Never commit real values.
# Local values come from `supabase status` after `supabase start`.

# Supabase (client and server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: SERVER ONLY (lib/supabase/admin.ts). Bypasses RLS.
SUPABASE_SECRET_KEY=

# Canonical URL for SEO, emails and QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Protects the keep-alive and cleanup cron routes
CRON_SECRET=
