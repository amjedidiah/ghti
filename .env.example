# Copy to .env.local and fill in. Never commit real values.
# Local values come from `supabase status` after `supabase start`.

# Supabase (client and server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: SERVER ONLY (lib/supabase/admin.ts). Bypasses RLS.
SUPABASE_SECRET_KEY=

# Canonical URL for SEO, emails and QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without RESEND_API_KEY, app emails go to MAILPIT_URL (local
# Supabase's Mailpit inbox); without either, they are skipped with a warning.
RESEND_API_KEY=
# Default: GHTI <no-reply@ghti.crm-world.org.ng>
EMAIL_FROM=
# Where replies go, once GHTI names an admissions address (client input #12)
EMAIL_REPLY_TO=
EMAIL_TO=
MAILPIT_URL=http://127.0.0.1:54324

# Protects the keep-alive and cleanup cron routes
CRON_SECRET=
